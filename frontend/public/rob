  $("qCopy").onclick=async e=>{
    const b=e.currentTarget, t=$("qSum").textContent;
    try{await navigator.clipboard.writeText(t); b.textContent=T("Copiado")}
    catch{const r=document.createRange(); r.selectNodeContents($("qSum")); const s=getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent=T("Texto seleccionado")}
    setTimeout(()=>b.textContent=T("Copiar texto"),2000);
  };
  function openQuote(svc){
    if(svc&&NOMBRES[svc]) sel.value=svc; syncSvc();
    done.hidden=true; form.hidden=false; $("q_err").hidden=true;
    openModal(qt,sel);
  }
  syncSvc();

  // al cambiar de idioma se repintan las partes generadas por código
  addEventListener("roblang",()=>{
    syncSvc(); dropLabel();
    if(!pf.hidden) renderPf();
    if(!done.hidden) renderDone();
    if(!$("q_err").hidden){$("q_err").hidden=true}
  });

  document.addEventListener("click",e=>{
    const q=e.target.closest("[data-quote]"), p=e.target.closest("[data-portfolio]"), pv=e.target.closest("[data-privacy]");
    if(pv){e.preventDefault(); openModal($("priv"))}
    else if(q){e.preventDefault(); openQuote(q.dataset.quote)}
    else if(p){e.preventDefault(); openPortfolio(p.dataset.portfolio)}
  });
  if(location.hash==="#privacidad") openModal($("priv"));
})();

/* Botón flotante: sube al inicio y deja el menú a la mano (en celular lo abre cuando llega arriba). */
(()=>{
  const b=document.getElementById("toTop"); if(!b) return;
  const reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
  const upd=()=>{b.hidden=!(scrollY>520)};
  addEventListener("scroll",upd,{passive:true});
  const atTop=cb=>{const t0=Date.now(); (function w(){if(scrollY<=2&&Date.now()-t0>=120||Date.now()-t0>2500) cb(); else setTimeout(w,60)})()};
  b.addEventListener("click",()=>{
    scrollTo({top:0,behavior:reduce?"auto":"smooth"});
    atTop(()=>{
      if(matchMedia("(max-width:760px)").matches) window.robMenu?.set(true);
      else document.querySelector("#mainNav a")?.focus({preventScroll:true});
    });
  });
  upd();
})();

</script>

