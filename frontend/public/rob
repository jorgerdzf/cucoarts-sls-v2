/* Layout: una "hoja de llamado" de producción. Claqueta como hero → desglose de servicios en filas
   (servicio · incluye · tarifa) → proceso real en orden → créditos de trabajo → contacto.
   Paleta CUCO ARTS: primarios de base, rojo de grabación como único acento. */
:root{
  --paper:#FFFFFF; --ground:#E2E0E0; --sand:#DBD5CD; --ink:#32332F; --ink-2:#5B5F49;
  --rec:#EA663D; --rec-ink:#B8431C; --slate:#32332F; --on-slate:#FFFFFF; --tbd:#F7D649;
  --display:"Neue Montreal","Helvetica Neue",Arial,sans-serif;
  --body:"Neue Montreal","Helvetica Neue",Arial,sans-serif;
  --mono:"Courier New",Courier,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --paper:#232322; --ground:#2B2B28; --sand:#45463F; --ink:#E2E0E0; --ink-2:#C1C68F;
  --rec:#F07A53; --rec-ink:#F29A7A; --slate:#111110; --on-slate:#E2E0E0; --tbd:#8A7420; color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#232322; --ground:#2B2B28; --sand:#45463F; --ink:#E2E0E0; --ink-2:#C1C68F;
  --rec:#F07A53; --rec-ink:#F29A7A; --slate:#111110; --on-slate:#E2E0E0; --tbd:#8A7420; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--paper);color:var(--ink);font:17px/1.55 var(--body);margin:0;padding-inline:clamp(16px,4vw,48px);padding-block:0 64px}
.wrap{max-width:1120px;margin:0 auto;display:grid;gap:clamp(56px,9vw,112px)}
a{color:inherit}
:focus-visible{outline:2px solid var(--rec);outline-offset:3px}
.mono{font-family:var(--mono)}
.label{font:700 12px/1.2 var(--mono);text-transform:uppercase;letter-spacing:.12em;color:var(--ink-2)}
.tbd{background:color-mix(in srgb,var(--tbd) 45%,transparent);border-bottom:2px dashed var(--tbd);padding:0 3px}
h2{font:500 clamp(28px,4.4vw,44px)/1.05 var(--display);letter-spacing:-.02em;margin:0;text-wrap:balance}

/* barra superior */
.top{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;justify-content:space-between;padding-block:22px;border-bottom:1px solid var(--sand)}
.top .name{font:700 18px/1 var(--display);letter-spacing:-.01em;text-decoration:none}
.top nav{display:flex;flex-wrap:wrap;gap:6px 22px}
.top nav a{font:14px var(--mono);text-decoration:none;color:var(--ink-2)}
.top nav a:hover{color:var(--rec-ink)}

/* hero */
.hero{display:grid;gap:28px;padding-top:0}
.hero h1{font:500 clamp(46px,9.5vw,128px)/.92 var(--display);letter-spacing:-.035em;word-spacing:.06em;margin:0;text-wrap:balance}
.hero h1 em{font-style:normal;color:var(--rec-ink)}
.hero .lede{font-size:clamp(18px,2.1vw,22px);max-width:36ch;margin:0;color:var(--ink)}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-flex;align-items:center;gap:10px;font:500 16px/1 var(--body);padding:15px 22px;border-radius:999px;border:1.5px solid var(--ink);text-decoration:none;color:var(--ink);background:transparent}
.btn.primary{background:var(--ink);color:var(--paper)}
.btn:hover{border-color:var(--rec);}

/* claqueta */
.slate{background:var(--slate);color:var(--on-slate);border-radius:6px;overflow:hidden;font-family:var(--mono)}
.slate .stripes{height:26px;background:repeating-linear-gradient(-45deg,var(--on-slate) 0 22px,var(--slate) 22px 44px)}
.slate .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
.slate .cell{padding:14px 16px;border-right:1px solid color-mix(in srgb,var(--on-slate) 25%,transparent);border-top:1px solid color-mix(in srgb,var(--on-slate) 25%,transparent);min-width:0}
.slate .cell:last-child{border-right:0}
.slate .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.65}
.slate .v{font-size:clamp(15px,2vw,20px);font-weight:700;margin-top:4px;overflow-wrap:anywhere}
.rec{display:inline-flex;align-items:center;gap:8px}
.rec::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--rec)}
@media (prefers-reduced-motion:no-preference){.rec::before{animation:blink 1.2s steps(2,start) infinite}}
@keyframes blink{to{visibility:hidden}}
#tc{font-variant-numeric:tabular-nums}

/* servicios: desglose */
.sec-head{display:grid;gap:10px;max-width:62ch}
.sec-head p{margin:0;color:var(--ink-2)}
.sheet{border-top:2px solid var(--ink)}
.row{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.5fr) minmax(230px,.9fr);gap:12px 28px;padding-block:26px;border-bottom:1px solid var(--sand)}
.row h3{font:500 clamp(21px,2.4vw,26px)/1.15 var(--display);letter-spacing:-.01em;margin:6px 0 0}
.row .for{font-size:15px;color:var(--ink-2);margin:8px 0 0}
.row ul{margin:0;padding-left:1.1em;display:grid;gap:4px}
.row li::marker{color:var(--rec)}
.price{font-family:var(--mono);text-align:right;min-width:0}
.price .opt+.opt{margin-top:14px}
.price b{display:block;font-size:22px;letter-spacing:-.02em;white-space:nowrap}
.price .opt+.opt b{font-size:19px}
.price b small{font:400 13px var(--mono);color:var(--ink-2);letter-spacing:0;margin-left:.6em}
.price span{display:block;font-size:13px;line-height:1.4;color:var(--ink-2);text-wrap:balance}
/* tablet y laptop chica: encabezado y precio arriba, lista de lo que incluye abajo a lo ancho */
@media (min-width:761px) and (max-width:1020px){.row{grid-template-columns:minmax(0,1fr) minmax(220px,auto);grid-template-areas:"head price" "list list"}.row>div:first-child{grid-area:head}.row>ul{grid-area:list}.row>.price{grid-area:price}}
.also{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:28px}
.also h4{font:500 21px/1.2 var(--display);margin:0 0 2px}
.also p{margin:0;font-size:15px;color:var(--ink-2)}

/* proceso */
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:0;border-top:2px solid var(--ink)}
.steps li{padding:20px 20px 22px 0;border-bottom:1px solid var(--sand);display:grid;gap:6px;align-content:start;min-width:0}
.steps .n{font:700 13px var(--mono);color:var(--rec-ink);letter-spacing:.08em}
.steps h3{font:500 19px/1.2 var(--display);margin:0}
.steps p{margin:0;font-size:15px;color:var(--ink-2)}

/* trabajo */
.credits{display:grid;gap:0;border-top:2px solid var(--ink)}
.credit{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 20px;align-items:baseline;padding-block:16px;border-bottom:1px solid var(--sand)}
.credit .t{font:500 clamp(19px,2.2vw,24px)/1.2 var(--display);letter-spacing:-.01em}
.credit .d{grid-column:1/-1;font-size:15px;color:var(--ink-2)}
.credit .tag{font:12px var(--mono);text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2);white-space:nowrap}
.more{margin-top:20px}
.links{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px 18px;font:14px var(--mono)}
.links a{color:var(--rec-ink);text-decoration:none;border-bottom:1px solid transparent}
.links a:hover{border-bottom-color:currentColor}
.collab{margin-top:36px;background:var(--ground);border-radius:6px;padding:24px 26px;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:18px 32px;align-items:center}
.collab h3{font:500 clamp(21px,2.4vw,26px)/1.15 var(--display);margin:8px 0 6px}
.collab p{margin:0;color:var(--ink-2);font-size:15px;max-width:52ch}
.links.big{font-size:18px;font-weight:700;flex-direction:column;gap:10px}
.cuco{border-left:3px solid var(--rec);padding-left:16px;margin:22px 0 0}
.cuco b{font-family:var(--mono);font-size:14px;letter-spacing:.1em;text-transform:uppercase;display:block;margin-bottom:4px;color:var(--rec-ink)}
@media (max-width:760px){.collab{grid-template-columns:1fr}}

/* título del sitio: qué es esta página dentro de CUCO ARTS */
.sitetitle{display:flex;align-items:center;gap:12px;min-width:0}
.minilogo{width:58px;aspect-ratio:480/248;flex:none;background:var(--ink);
  -webkit-mask:url(data:image/png;base64,) center/contain no-repeat;mask:url(data:image/png;base64,) center/contain no-repeat}
.minilogo:hover{background:var(--rec-ink)}
.sitename{display:grid;gap:2px;text-decoration:none;min-width:0;padding-left:12px;border-left:1px solid var(--sand)}
.sitename b{font:700 17px/1.1 var(--display);letter-spacing:-.01em}
.sitename span{font-size:11.5px;line-height:1.3;color:var(--ink-2);letter-spacing:.02em;max-width:34ch}
.navsub,.menubtn{display:none}

/* celular: menú oculto que se despliega; el botón de modo queda siempre a la vista */
@media (max-width:760px){
  .top{position:relative;flex-wrap:nowrap;padding-block:12px;gap:12px}
  .sitename span{display:none}
  .sitename b{font-size:16px}
  .minilogo{width:46px}
  .topright{flex-wrap:nowrap;gap:8px}
  .top .theme{width:40px;height:40px;padding:0;justify-content:center;flex:none}
  .theme #themeLabel{display:none}
  .menubtn{display:grid;place-content:center;gap:5px;width:40px;height:40px;border-radius:999px;border:1px solid var(--sand);background:var(--ground);cursor:pointer;padding:0}
  .menubtn span{display:block;width:18px;height:1.8px;background:var(--ink);border-radius:2px;transition:transform .3s cubic-bezier(.2,.7,.2,1),opacity .2s}
  .menubtn[aria-expanded="true"] span:nth-child(1){transform:translateY(6.8px) rotate(45deg)}
  .menubtn[aria-expanded="true"] span:nth-child(2){opacity:0}
  .menubtn[aria-expanded="true"] span:nth-child(3){transform:translateY(-6.8px) rotate(-45deg)}
  .mainnav{position:absolute;top:100%;left:calc(-1 * clamp(16px,4vw,48px));right:calc(-1 * clamp(16px,4vw,48px));z-index:30;
    display:flex;flex-direction:column;gap:0!important;background:var(--paper);border-bottom:1px solid var(--sand);
    padding:6px clamp(16px,4vw,48px) 18px;box-shadow:0 24px 40px -28px rgb(0 0 0 / .45);
    visibility:hidden;opacity:0;clip-path:inset(0 0 100% 0);transform:translateY(-6px);
    transition:clip-path .38s cubic-bezier(.2,.7,.2,1),opacity .25s,transform .38s cubic-bezier(.2,.7,.2,1),visibility 0s .38s}
  .mainnav.open{visibility:visible;opacity:1;clip-path:inset(0 0 0 0);transform:none;transition:clip-path .38s cubic-bezier(.2,.7,.2,1),opacity .25s,transform .38s cubic-bezier(.2,.7,.2,1),visibility 0s}
  .navsub{display:block;margin:6px 0 8px;font-size:12px;color:var(--ink-2)}
  .top .mainnav a{font:500 22px/1.2 var(--display);color:var(--ink);padding:14px 0;border-bottom:1px solid var(--sand);
    opacity:0;translate:0 8px;transition:opacity .3s,translate .35s cubic-bezier(.2,.7,.2,1)}
  .top .mainnav a:last-child{border-bottom:0}
  .mainnav.open a{opacity:1;translate:0 0;transition-delay:calc(60ms + var(--i) * 45ms)}
}
@media (max-width:760px) and (prefers-reduced-motion:reduce){.mainnav,.mainnav.open,.top .mainnav a,.menubtn span{transition:none}}

/* menú: botón de tema */
.topright{display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px}
.theme{display:inline-flex;align-items:center;gap:8px;font:13px var(--mono);color:var(--ink);background:var(--ground);border:1px solid var(--sand);border-radius:999px;padding:7px 13px;cursor:pointer}
.theme:hover{border-color:var(--rec)}
.theme svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
.theme .i-moon{fill:currentColor;stroke:none}
.theme[aria-pressed="true"] .i-moon,.theme[aria-pressed="false"] .i-sun{display:none}

/* galería: cuadrícula tipo catálogo de producto, 1:1, 4 columnas en escritorio y 2 en celular */
.gallery{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(10px,1.6vw,18px)}
.shot{position:relative;aspect-ratio:1/1;max-width:100%;overflow:hidden;border-radius:6px;background:var(--ground);cursor:default;
  outline-offset:3px;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s;animation:shotIn .5s var(--d,0ms) both}
.shot img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .4s}
.shot::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgb(20 20 18 / .78),rgb(20 20 18 / 0) 55%);opacity:0;transition:opacity .35s}
.shot::before{content:"";position:absolute;top:12px;left:12px;width:10px;height:10px;border-radius:50%;background:var(--rec);z-index:2;opacity:0;transform:scale(.4);transition:opacity .3s,transform .3s}
.cap{position:absolute;left:0;right:0;bottom:0;z-index:2;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:end;
  padding:14px 14px 13px;color:#fff;transform:translateY(100%);transition:transform .4s cubic-bezier(.2,.7,.2,1)}
.cap b{font:500 15px/1.2 var(--display);display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere}
.cap .mono{font-size:12px;letter-spacing:.06em;opacity:.85}
.shot:hover,.shot:focus-visible{transform:translateY(-4px);box-shadow:0 14px 30px -14px rgb(0 0 0 / .45)}
.shot:hover img,.shot:focus-visible img{transform:scale(1.08);filter:saturate(1.12) contrast(1.04)}
.shot:hover::after,.shot:focus-visible::after,.shot:hover::before,.shot:focus-visible::before{opacity:1}
.shot:hover::before,.shot:focus-visible::before{transform:scale(1)}
.shot:hover .cap,.shot:focus-visible .cap{transform:translateY(0)}
@media (hover:none){.shot::after{opacity:1}.cap{transform:none}}
@keyframes shotIn{from{opacity:0;translate:0 12px}to{opacity:1;translate:0 0}}
@media (prefers-reduced-motion:reduce){.shot,.shot img,.cap,.shot::after,.shot::before{transition:none;animation:none}.shot:hover img,.shot:focus-visible img{transform:none}.shot:hover,.shot:focus-visible{transform:none}}
.shot{cursor:zoom-in}

/* visor de fotos: por encima de la página, zoom con pellizco/rueda/doble toque */
.lb{position:fixed;inset:0;z-index:50;background:rgb(17 17 16 / .96);color:#F2F1EE;display:grid;grid-template-rows:auto 1fr auto;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);animation:lbIn .25s ease both;user-select:none;-webkit-user-select:none}
@keyframes lbIn{from{opacity:0}to{opacity:1}}
.lb-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px;padding:12px clamp(12px,3vw,24px);z-index:2}
.lb-meta{font-size:13px;letter-spacing:.06em;opacity:.85;min-width:0}
.lb-tools{display:flex;align-items:center;gap:6px}
.lb-btn{width:40px;height:40px;border-radius:50%;border:1px solid rgb(255 255 255 / .25);background:rgb(255 255 255 / .06);color:inherit;font:400 20px/1 var(--body);cursor:pointer;display:grid;place-items:center}
.lb-btn:hover{border-color:var(--rec)}
.lb-close{margin-left:8px;font-size:16px}
.lb-zoom{min-width:52px;text-align:center;font-size:13px}
.lb-stage{position:relative;overflow:hidden;touch-action:none;display:grid;place-items:center;cursor:grab;min-height:0}
.lb-stage.dragging{cursor:grabbing}
.lb-stage img{max-width:100%;max-height:100%;width:auto;height:auto;user-select:none;-webkit-user-drag:none;transform-origin:center center;will-change:transform}
.lb-stage img.smooth{transition:transform .25s cubic-bezier(.2,.7,.2,1)}
.lb-nav{position:absolute;top:50%;translate:0 -50%;width:48px;height:64px;border:0;border-radius:6px;background:rgb(255 255 255 / .08);color:inherit;font:300 34px/1 var(--body);cursor:pointer;z-index:2}
.lb-nav:hover{background:rgb(255 255 255 / .16)}
.lb-prev{left:clamp(6px,2vw,20px)}.lb-next{right:clamp(6px,2vw,20px)}
.lb-hint{text-align:center;font-size:12px;opacity:.6;margin:0;padding:10px 16px 14px}
.lb button:focus-visible{outline:2px solid var(--rec);outline-offset:2px}
@media (max-width:760px){.lb-nav{display:none}}
@media (prefers-reduced-motion:reduce){.lb{animation:none}.lb-stage img.smooth{transition:none}}
/* tarjetas de servicios extra con ícono y acciones */
.xcard{background:var(--ground);border-radius:6px;padding:22px 22px 20px;min-width:0;display:grid;gap:8px;align-content:start;
  transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}
.xcard:hover{transform:translateY(-3px);box-shadow:0 14px 30px -18px rgb(0 0 0 / .4)}
.xicon{width:44px;height:44px;fill:none;stroke:var(--ink);stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round;margin-bottom:6px}
.xcard:hover .xicon{stroke:var(--rec-ink)}
.xcard h4{margin:0}
.xactions{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
.btn.sm{font-size:14px;padding:10px 16px;cursor:pointer}
.btn.primary{cursor:pointer}
button.btn{font-family:var(--body);cursor:pointer}

/* aparición al hacer scroll: solo para lo que está debajo del primer pantallazo */
.reveal.pre{opacity:0;translate:0 18px}
.reveal{transition:opacity .7s ease,translate .7s cubic-bezier(.2,.7,.2,1)}
@media (prefers-reduced-motion:reduce){.reveal.pre{opacity:1;translate:none}.reveal{transition:none}}

/* ventanas (portafolio y cotizador) */
.modal{position:fixed;inset:0;z-index:40;background:rgb(17 17 16 / .55);display:grid;place-items:center;padding:clamp(0px,3vw,32px);animation:lbIn .2s ease both}
.modal-box{background:var(--paper);color:var(--ink);width:min(720px,100%);max-height:100%;overflow:auto;border-radius:10px;padding:clamp(18px,3vw,32px);
  box-shadow:0 30px 80px -30px rgb(0 0 0 / .6);overscroll-behavior:contain}
.modal-box.wide{width:min(1120px,100%)}
.modal-head{display:flex;justify-content:space-between;align-items:start;gap:16px;margin-bottom:18px}
.modal-head h3{font:500 clamp(24px,3.4vw,34px)/1.1 var(--display);margin:6px 0 0;letter-spacing:-.02em}
.mclose{color:var(--ink);border-color:var(--sand);background:var(--ground);flex:none}
@media (max-width:600px){.modal{padding:0}.modal-box{border-radius:0;height:100%}}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
/* encabezado del portafolio fijo: título, Cotizar y filtros siempre a la vista */
.pf-sticky{position:sticky;top:calc(-1 * clamp(18px,3vw,32px));z-index:3;background:var(--paper);
  margin:calc(-1 * clamp(18px,3vw,32px)) calc(-1 * clamp(18px,3vw,32px)) 18px;padding:clamp(18px,3vw,32px) clamp(18px,3vw,32px) 2px;
  border-bottom:1px solid var(--sand)}
.pf-sticky .modal-head{margin-bottom:14px}
.pf-sticky .chips{margin-bottom:14px}
.head-actions{display:flex;align-items:center;gap:10px;flex:none}
.btn.hot{background:var(--rec);border-color:var(--rec);color:#1C1C1A;font-weight:700}
.btn.hot:hover{filter:brightness(1.06)}
/* botones dentro del desglose de servicios */
.rowact{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px;margin-top:14px}
@media (max-width:760px){.rowact{justify-content:flex-start}}
/* foto de perfil con anillo de colores de la marca */
