(()=>{
  const el=document.getElementById("tc"); if(!el) return;
  if(matchMedia("(prefers-reduced-motion: reduce)").matches){el.textContent="00:00:12:08";return}
  const t0=performance.now(), p=n=>String(n).padStart(2,"0");
  const tick=()=>{const f=Math.floor((performance.now()-t0)/1000*24);
    el.textContent=`${p(Math.floor(f/86400))}:${p(Math.floor(f/1440)%60)}:${p(Math.floor(f/24)%60)}:${p(f%24)}`;
    requestAnimationFrame(tick)};
  tick();
})();

/* Idioma ES/EN: el HTML está en español y el diccionario inglés (#i18n-en) se aplica encima.
   Se recuerda en localStorage; sin elección previa se usa el idioma del navegador. */
(()=>{
  const KEY="cucoarts-lang", root=document.documentElement;
  const EN=JSON.parse(document.getElementById("i18n-en").textContent);
  const norm=s=>s.replace(/\s+/g," ").trim();
  const read=()=>{try{return localStorage.getItem(KEY)}catch(e){return null}};
  const save=v=>{try{localStorage.setItem(KEY,v)}catch(e){}};
  let lang=read();
  if(lang!=="en"&&lang!=="es") lang=(navigator.language||"es").toLowerCase().startsWith("en")?"en":"es";
  const t=s=>lang==="en"&&EN[s]!==undefined?EN[s]:s;
  const META={
    es:{title:document.title,desc:document.querySelector('meta[name="description"]').content},
    en:{title:"Roberto Escobedo (Rob) · Audiovisual producer in Monterrey",desc:"Cultural event coverage, content for brands and education, and post-production in Monterrey, Mexico. Roberto Escobedo (Rob), producer and founder of CUCO ARTS."}};
  const SKIP="script,style,pre,[data-noi18n]";
  const texts=[]; const w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
  for(let n;n=w.nextNode();){ if(n.nodeValue.trim()&&!n.parentElement.closest(SKIP)){n.__es=n.nodeValue; texts.push(n)} }
  const attrs=[]; document.querySelectorAll("[aria-label],[placeholder],[title]").forEach(el=>{
    if(el.closest("[data-noi18n]")) return;
    ["aria-label","placeholder","title"].forEach(a=>{const v=el.getAttribute(a); if(v) attrs.push([el,a,v])})});
  function applyAll(){
    texts.forEach(n=>{
      const es=n.__es, tr=lang==="en"?EN[norm(es)]:undefined;
      if(tr===undefined){n.nodeValue=es; return}
      let lead=/^\s*/.exec(es)[0]; const trail=/\s*$/.exec(es)[0];
      if(/^[.,;:!?)]/.test(tr)) lead="";
      n.nodeValue=lead+tr+trail;
    });
    attrs.forEach(([el,a,v])=>el.setAttribute(a,lang==="en"&&EN[v]!==undefined?EN[v]:v));
    root.lang=lang; document.title=META[lang].title;
    document.querySelector('meta[name="description"]').content=META[lang].desc;
    const b=document.getElementById("langBtn");
    if(b){document.getElementById("langLabel").textContent=lang==="en"?"ES":"EN";
      b.setAttribute("aria-label",lang==="en"?"Cambiar a español":"Switch to English");
      b.setAttribute("aria-pressed",String(lang==="en")); b.title=b.getAttribute("aria-label")}
  }
  function set(l,persist){lang=l; if(persist) save(l); applyAll(); dispatchEvent(new Event("roblang"))}
  window.robI18n={t,get lang(){return lang},set};
  document.getElementById("langBtn")?.addEventListener("click",()=>set(lang==="en"?"es":"en",true));
  addEventListener("storage",e=>{if(e.key===KEY&&(e.newValue==="en"||e.newValue==="es")&&e.newValue!==lang) set(e.newValue,false)});
  applyAll();
})();

/* Modo día / noche compartido por todo cucoarts.com: misma llave en localStorage para todas las páginas.
   Respeta el sistema hasta que la persona elige. */
(()=>{
  const KEY="cucoarts-theme", root=document.documentElement, btn=document.getElementById("themeBtn"), label=document.getElementById("themeLabel");
  const sysDark=matchMedia("(prefers-color-scheme: dark)");
  const read=()=>{try{return localStorage.getItem(KEY)||localStorage.getItem("rob-theme")}catch(e){return null}};
  const save=v=>{try{localStorage.setItem(KEY,v)}catch(e){}};
  const current=()=>root.dataset.theme||(sysDark.matches?"dark":"light");
  const paint=()=>{const dark=current()==="dark";
    const T=window.robI18n.t; btn.setAttribute("aria-pressed",String(dark)); label.textContent=T(dark?"Modo día":"Modo noche");
    btn.setAttribute("aria-label",T(dark?"Cambiar a modo día":"Cambiar a modo noche"))};
  const saved=read(); if(saved==="dark"||saved==="light") root.dataset.theme=saved;
  btn.addEventListener("click",()=>{const next=current()==="dark"?"light":"dark"; root.dataset.theme=next; save(next); paint()});
  sysDark.addEventListener?.("change",paint);
  addEventListener("storage",e=>{if(e.key===KEY&&e.newValue){root.dataset.theme=e.newValue; paint()}});
  addEventListener("roblang",paint);
  paint();
})();

/* Menú en celular: se despliega con el botón y se cierra al elegir, con Esc o tocando fuera. */
(()=>{
  const btn=document.getElementById("menuBtn"), nav=document.getElementById("mainNav");
  const set=open=>{nav.classList.toggle("open",open); btn.setAttribute("aria-expanded",String(open)); btn.setAttribute("aria-label",window.robI18n.t(open?"Cerrar menú":"Abrir menú"))};
  btn.addEventListener("click",()=>set(!nav.classList.contains("open")));
  nav.addEventListener("click",e=>{if(e.target.closest("a")) set(false)});
  document.addEventListener("keydown",e=>{if(e.key==="Escape"&&nav.classList.contains("open")){set(false); btn.focus()}});
  document.addEventListener("click",e=>{if(nav.classList.contains("open")&&!e.target.closest(".top")) set(false)});
  matchMedia("(min-width: 761px)").addEventListener?.("change",e=>{if(e.matches) set(false)});
  addEventListener("roblang",()=>set(nav.classList.contains("open")));
  set(nav.classList.contains("open"));
  window.robMenu={set};
